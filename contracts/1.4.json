{
  "format": "1.4",
  "aliases": [],
  "okf": "0.2",
  "shared-fields": {
    "derived-from": { "kind": "wikilink", "aliases": ["derived_from"] },
    "tags": { "kind": "token-or-list", "values": [], "open": true },
    "created_at": { "kind": "date", "aliases": ["created-at"] },
    "updated_at": { "kind": "date", "aliases": ["updated-at"] },
    "created_by": { "kind": "string", "aliases": ["created-by"] },
    "sources": { "kind": "object" },
    "atlassian_id": { "kind": "string" },
    "atlassian_url": { "kind": "string" }
  },
  "types": {
    "agreement": { "entity": true, "required": ["agreement-type"], "folders": ["agreements"], "fields": {
      "agreement-type": { "kind": "token-or-list", "values": ["organizational", "work"], "open": false },
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "role", "unit"], "aliases": ["for_domain"] },
      "agreement-of": { "kind": "locator", "targets": ["work-system", "unit", "individual"] },
      "derived-from": { "kind": "wikilink", "targets": ["organizational-decision-record", "proposal"], "aliases": ["derived_from"] },
      "version": { "kind": "string" },
      "decision_date": { "kind": "date" },
      "review_date": { "kind": "date" }
    } },
    "ai-agent": { "entity": true, "required": [], "folders": ["ai-agents"], "fields": {
      "platform": { "kind": "string" },
      "description": { "kind": "string" },
      "status": { "kind": "enum", "values": ["active", "deactivated"], "open": true },
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "role", "unit"], "aliases": ["for_domain"] },
      "bound-to": { "kind": "locator", "targets": ["work-system", "unit", "individual"] }
    } },
    "driver": { "entity": true, "required": [], "folders": ["drivers"], "fields": {
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "role", "unit"], "aliases": ["for_domain"] },
      "derived-from": { "kind": "wikilink", "targets": ["insight"], "aliases": ["derived_from"] },
      "status": { "kind": "string" }
    } },
    "flight-item-type": { "entity": true, "required": [], "folders": ["flight-item-types"], "fields": {
      "uses-route": { "kind": "wikilink", "targets": ["flight-route"] }
    } },
    "flight-route": { "entity": true, "required": [], "folders": ["flight-routes"], "fields": {} },
    "individual": { "entity": true, "required": [], "folders": ["individuals"], "fields": {
      "role": { "kind": "string" },
      "level": { "kind": "string" },
      "reports-to": { "kind": "wikilink", "targets": ["individual"], "aliases": ["reports_to"] },
      "member-of": { "kind": "wikilink", "targets": ["unit"] },
      "position_key": { "kind": "string" },
      "external_position_key": { "kind": "string" }
    } },
    "insight": { "entity": true, "required": [], "folders": ["insights"], "fields": {
      "observes": { "kind": "locator", "targets": ["any"] },
      "title": { "kind": "string" },
      "status": { "kind": "enum", "values": ["new", "acknowledged"], "open": false },
      "acknowledged_at": { "kind": "datetime" },
      "derived-from": { "kind": "wikilink", "targets": ["signal"], "aliases": ["derived_from"] }
    } },
    "interaction": { "entity": true, "required": ["interaction-type"], "folders": ["interactions"], "fields": {
      "interaction-type": { "kind": "token-or-list", "values": ["meeting", "conversation", "bilateral"], "open": true },
      "interaction-of": { "kind": "locator", "targets": ["work-system", "unit", "individual"] },
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "role", "unit"], "aliases": ["for_domain"] },
      "start": { "kind": "datetime" },
      "end": { "kind": "datetime" },
      "rrule": { "kind": "string", "format": "rrule" },
      "version": { "kind": "string" }
    } },
    "mandate": { "entity": true, "required": [], "folders": ["mandates"], "fields": {
      "for-domain": { "kind": "wikilink", "targets": ["role", "unit", "work-system"], "aliases": ["for_domain"] },
      "delegator": { "kind": "wikilink", "targets": ["role", "unit", "work-system", "individual"] },
      "mandate-of": { "kind": "locator", "targets": ["any"] },
      "derived-from": { "kind": "wikilink", "targets": ["organizational-decision-record", "proposal"], "aliases": ["derived_from"] },
      "version": { "kind": "string" },
      "decision_date": { "kind": "date" },
      "review_date": { "kind": "date" }
    } },
    "organizational-decision-record": { "entity": true, "required": [], "folders": ["decision-records"], "fields": {
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "role", "unit"], "aliases": ["for_domain"] },
      "status": { "kind": "enum", "values": ["proposed", "accepted", "superseded", "deprecated"], "open": false },
      "date": { "kind": "date" },
      "decision-makers": { "kind": "wikilink" }
    } },
    "proposal": { "entity": true, "required": [], "folders": ["proposals"], "fields": {
      "derived-from": { "kind": "wikilink", "targets": ["driver", "insight", "signal"], "aliases": ["derived_from"] },
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "role", "unit"], "aliases": ["for_domain"] },
      "status": { "kind": "enum", "values": ["draft", "in-consent", "consented", "declined"], "open": false }
    } },
    "role": { "entity": true, "required": [], "folders": ["roles"], "fields": {
      "role-keeper": { "kind": "wikilink", "targets": ["individual"], "aliases": ["role_keeper"] },
      "for-domain": { "kind": "wikilink", "targets": ["work-system", "unit"], "aliases": ["for_domain"] },
      "version": { "kind": "string" },
      "decision_date": { "kind": "date" },
      "review_date": { "kind": "date" }
    } },
    "signal": { "entity": true, "required": [], "folders": ["signals"], "fields": {
      "observes": { "kind": "locator", "targets": ["any"] }
    } },
    "unit": { "entity": true, "required": [], "folders": ["units", "work-systems"], "fields": {
      "unit-type": { "kind": "token-or-list", "values": ["team", "work-system"], "open": true },
      "flightlevel": { "kind": "enum", "values": ["1", "2", "3"], "open": false },
      "member-of": { "kind": "wikilink", "targets": ["unit"] },
      "contributes-to": { "kind": "wikilink", "targets": ["work-system"] },
      "delegator": { "kind": "wikilink" },
      "version": { "kind": "string" },
      "decision_date": { "kind": "date" },
      "review_date": { "kind": "date" },
      "term": { "kind": "string" }
    } },
    "visualization": { "entity": true, "required": ["visualization-type"], "folders": ["visualizations"], "fields": {
      "visualization-type": { "kind": "token-or-list", "values": ["board"], "open": false },
      "title": { "kind": "string" },
      "visualization-of": { "kind": "wikilink", "targets": ["work-system"], "aliases": ["visualization_of"] }
    } },
    "readme": { "entity": false, "required": [] },
    "tour": { "entity": false, "required": [] }
  },
  "rules": [
    {
      "type": "unit",
      "when": { "field": "unit-type", "contains": "work-system" },
      "require": { "field": "flightlevel", "oneOf": ["1", "2", "3"] }
    }
  ]
}
