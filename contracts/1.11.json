  "managed": {
    "$comment": "The places in a file that tools read by their form. Keep to the form and a tool gives you what `gives` says; anything else in the body stays free text. Generic on purpose: no tool is named.",
    "rule": {
      "heading": "an ATX heading of level 2; its text matches the primary or an alias exactly, case-insensitive, trimmed",
      "column": "a table header cell matches the primary or an alias exactly, case-insensitive, trimmed",
      "section-end": "the next heading of level 1 or 2",
      "fenced-code": "lines inside a fenced code block are neither headings nor table rows"
    },
    "places": [
      {
        "name": "fences",
        "where": {
          "types": "any",
          "form": "fenced code block"
        },
        "tags": [
          {
            "tag": "dwsd.board",
            "aliases": [
              "dwsd-board",
              "wsd.board",
              "wsd-board"
            ]
          },
          {
            "tag": "dwsd.flightroute",
            "aliases": [
              "dwsd-flightroute",
              "wsd.flightroute",
              "wsd-flightroute"
            ]
          },
          {
            "tag": "dwsd.topology",
            "aliases": [
              "dwsd-topology",
              "wsd.topology",
              "wsd-topology"
            ]
          },
          {
            "tag": "dwsd.orgchart",
            "aliases": [
              "dwsd-orgchart",
              "wsd.orgchart",
              "wsd-orgchart"
            ]
          },
          {
            "tag": "dwsd.units",
            "aliases": [
              "dwsd-units",
              "wsd.units",
              "wsd-units"
            ]
          },
          {
            "tag": "dwsd.change-trail",
            "aliases": [
              "dwsd-change-trail",
              "wsd.change-trail",
              "wsd-change-trail"
            ]
          }
        ],
        "gives": "a view drawn from the fence; its grammar is the fence spec in conventions.md › Embedded DSL fences"
      },
      {
        "name": "interactions-table",
        "where": {
          "types": [
            "interaction",
            "meeting"
          ],
          "heading": {
            "primary": "Interactions",
            "aliases": []
          }
        },
        "columns": {
          "name": {
            "primary": "Name",
            "aliases": []
          },
          "result": {
            "primary": "Result",
            "aliases": [
              "Outcome"
            ]
          },
          "locator": {
            "primary": "Interaction of",
            "aliases": [
              "interaction-of"
            ]
          }
        },
        "gives": "each row an interaction; a row with a locator shows where the locator points, with its result"
      },
      {
        "name": "agreements-table",
        "where": {
          "types": "any",
          "heading": {
            "primary": "Agreements",
            "aliases": []
          }
        },
        "columns": {
          "name": {
            "primary": "Name",
            "aliases": []
          },
          "result": {
            "primary": "Result",
            "aliases": [
              "Outcome"
            ]
          },
          "locator": {
            "primary": "Agreement of",
            "aliases": [
              "agreement-of"
            ]
          }
        },
        "gives": "each row an agreement; a row with a locator shows where the locator points"
      },
      {
        "name": "outcome-section",
        "where": {
          "types": [
            "interaction",
            "meeting"
          ],
          "heading": {
            "primary": "What should come out of it?",
            "aliases": [
              "What is the outcome?",
              "Outcome"
            ]
          }
        },
        "gives": "the first lines, shown as the short result where the interaction is drawn"
      },
      {
        "name": "decision-section",
        "where": {
          "types": [
            "proposal"
          ],
          "heading": {
            "primary": "Decision",
            "aliases": [
              "Outcome"
            ]
          }
        },
        "gives": "consented or declined, shown where the proposal is drawn"
      },
      {
        "name": "mandate-sections",
        "where": {
          "types": [
            "individual",
            "role",
            "unit",
            "ai-agent"
          ],
          "headings": [
            {
              "heading": {
                "primary": "Accountabilities",
                "aliases": []
              },
              "mode": "must"
            },
            {
              "heading": {
                "primary": "Decision Rights",
                "aliases": []
              },
              "mode": "may"
            },
            {
              "heading": {
                "primary": "Key Responsibilities",
                "aliases": []
              },
              "mode": "must"
            },
            {
              "heading": {
                "primary": "Mandates",
                "aliases": []
              },
              "mode": null
            }
          ]
        },
        "columns": {
          "name": {
            "primary": "Name",
            "aliases": []
          },
          "locator": {
            "primary": "Mandate of",
            "aliases": [
              "mandate-of"
            ]
          }
        },
        "gives": "each row a mandate of the file's holder; a row with a locator shows as a mandate chip where it points"
      },
      {
        "name": "live-links",
        "where": {
          "types": "any",
          "form": "inline Markdown link on a prose line of the body",
          "title": "^[a-z][a-z0-9-]{0,31}:\\S+$"
        },
        "gives": "a reference to an object in another system; a host that knows the system can resolve it live"
      }
    ]
  }
